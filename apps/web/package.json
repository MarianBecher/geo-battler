{
  "name": "@geo-battler/web",
  "version": "0.1.0",
  "private": true,
  "description": "The geo-battler browser client: the passport-styled game UI, built with Vite.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/copy-assets.mjs",
    "build:world": "node scripts/build-world.ts"
  },
  "dependencies": {
    "@geo-battler/shared": "workspace:*",
    "anthem-scores": "^0.1.1",
    "pencil-faces": "^1.0.0",
    "tiny-orchestra": "^0.2.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
