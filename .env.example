# --- Two keys, because a Google key can carry only ONE application restriction ---

# Goes to the browser. Restriction: none (see README for why), or "Websites"
# (HTTP referrer) if you play via a fixed hostname.
# API restriction: Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_KEY=

# Stays on the server (location search via Street View metadata, place names
# via Geocoding). Restriction: "IP addresses" or none.
# API restriction: Street View Static API + Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# Convenient fallback: a single unrestricted key for both.
# Only used when the two above are empty.
#GOOGLE_MAPS_API_KEY=

# Port of the game server (the Vite dev server proxies to it).
PORT=3000

# Language of the place names in the reveal (a Google Maps language code).
#GEOCODE_LANGUAGE=en

# Where the records across evenings live (default: data/hall.json).
#HALL_FILE=data/hall.json

# The browser key is only handed to clients on the local network
# (10.x, 172.16-31.x, 192.168.x, loopback, IPv6 ULA/link-local).
# Set to 1 if the server is meant to be reachable from outside.
#ALLOW_PUBLIC_CLIENTS=1
